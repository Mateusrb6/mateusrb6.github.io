---
import BaseLayout from "./BaseLayout.astro";

const { title, description, date, tags = [], lang = "pt-BR", backHref } = Astro.props;
const isEnglish = lang === "en";
const defaultBackHref = Astro.url.pathname.includes("/writeups/")
  ? (isEnglish ? "/en/writeups" : "/writeups")
  : (isEnglish ? "/en/articles" : "/artigos");
---
<BaseLayout title={title} description={description} type="article" lang={lang}>
  <article class="prose-page">
    <header class="article-header">
      <a class="back-link" href={backHref || defaultBackHref}>← {isEnglish ? "Back" : "Voltar"}</a>
      <h1>{title}</h1>
      <p>{description}</p>
      <div class="article-meta">
        <time datetime={date.toISOString()}>{date.toLocaleDateString(isEnglish ? "en-US" : "pt-BR", { day: "2-digit", month: "long", year: "numeric" })}</time>
        {tags.map((tag: string) => <span>{tag}</span>)}
      </div>
    </header>
    <div class="prose"><slot /></div>
  </article>
  <script>
    document.addEventListener("astro:page-load", () => {
      document.querySelectorAll(".prose pre").forEach((pre) => {
        if (pre.querySelector(".copy-code")) return; // Prevent duplicate buttons

        const button = document.createElement("button");
        button.className = "copy-code";
        button.type = "button";
        const isEnglish = document.documentElement.lang === "en";
        button.textContent = "[ COPY ]";
        button.setAttribute("aria-label", isEnglish ? "Copy code block" : "Copiar bloco de código");
        button.setAttribute("aria-live", "polite");
        const code = pre.querySelector("code");
        let resetTimer: number | undefined;

        button.addEventListener("click", async () => {
          try {
            const text = code?.textContent || "";
            if (navigator.clipboard?.writeText && window.isSecureContext) {
              await navigator.clipboard.writeText(text);
            } else {
              const selection = window.getSelection();
              const range = document.createRange();
              range.selectNodeContents(code || pre);
              selection?.removeAllRanges();
              selection?.addRange(range);
              throw new Error("Clipboard API indisponível");
            }
            button.textContent = isEnglish ? "[ COPIED ]" : "[ SECURED ]";
            button.setAttribute("aria-label", isEnglish ? "Code copied" : "Código copiado");
          } catch {
            button.textContent = "[ SELECT ]";
            button.setAttribute("aria-label", isEnglish ? "Code selected; copy it manually" : "Código selecionado; copie manualmente");
          }
          window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            button.textContent = "[ COPY ]";
            button.setAttribute("aria-label", isEnglish ? "Copy code block" : "Copiar bloco de código");
          }, 2400);
        });
        pre.appendChild(button);
      });
    });
  </script>
</BaseLayout>
