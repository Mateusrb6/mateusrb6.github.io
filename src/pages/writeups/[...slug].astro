---
import { getCollection, render } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
export async function getStaticPaths() {
  const items = await getCollection("writeups");
  return items.filter((item) => !item.data.draft).map((item) => ({ params: { slug: item.id }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
---
<ContentLayout title={item.data.title} description={item.data.summary} date={item.data.date} tags={[item.data.platform, item.data.difficulty, ...item.data.tags]}>
  <Content />
</ContentLayout>
