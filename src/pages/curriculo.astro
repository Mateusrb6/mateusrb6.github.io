          <thead><tr><th scope="col">Curso ou certificação</th><th scope="col">Emissor</th><th scope="col">Situação</th></tr></thead>
          <tbody>
            <tr><td data-label="Curso ou certificação">Google Cybersecurity Professional Certificate</td><td data-label="Emissor">Google</td><td data-label="Situação">abr. 2025 · credencial FO6HJLJQ9NYU</td></tr>
            <tr><td data-label="Curso ou certificação">EF SET English — 70/100 (C1)</td><td data-label="Emissor">EF SET</td><td data-label="Situação">concluído</td></tr>
            <tr><td data-label="Curso ou certificação">Networking Basics</td><td data-label="Emissor">Cisco NetAcad</td><td data-label="Situação">ago. 2025</td></tr>
            <tr><td data-label="Curso ou certificação">SOC Level 1 e Junior Penetration Tester</td><td data-label="Emissor">TryHackMe</td><td data-label="Situação">em andamento</td></tr>
            <tr><td data-label="Curso ou certificação">Python 3</td><td data-label="Emissor">Curso em Vídeo</td><td data-label="Situação">mar. 2024</td></tr>
