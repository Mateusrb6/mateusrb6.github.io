            <tr><td data-label="Curso ou certificação">EF SET English — 70/100 (C1 Proficiência Eficaz)</td><td data-label="Emissor">EF SET</td><td data-label="Situação">concluído</td></tr>
            <tr><td data-label="Curso ou certificação">Networking Basics</td><td data-label="Emissor">Cisco Networking Academy</td><td data-label="Situação">2025</td></tr>
