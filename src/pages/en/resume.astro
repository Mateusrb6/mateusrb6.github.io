            <tr><td data-label="Course or certification">Google Cybersecurity Professional Certificate</td><td data-label="Issuer">Google</td><td data-label="Status">Apr 2025 · credential FO6HJLJQ9NYU</td></tr>
            <tr><td data-label="Course or certification">EF SET English — 70/100 (C1)</td><td data-label="Issuer">EF SET</td><td data-label="Status">Completed</td></tr>
            <tr><td data-label="Course or certification">Networking Basics</td><td data-label="Issuer">Cisco NetAcad</td><td data-label="Status">Aug 2025</td></tr>
            <tr><td data-label="Course or certification">SOC Level 1 and Junior Penetration Tester</td><td data-label="Issuer">TryHackMe</td><td data-label="Status">In progress</td></tr>
            <tr><td data-label="Course or certification">Python 3</td><td data-label="Issuer">Curso em Vídeo</td><td data-label="Status">Mar 2024</td></tr>
