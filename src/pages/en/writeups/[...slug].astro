---
import { getCollection, render } from "astro:content";
import ContentLayout from "../../../layouts/ContentLayout.astro";
import { translateMetadata, writeupEnglish } from "../../../data/i18n";
export async function getStaticPaths() {
  const items = await getCollection("writeups");
  return items.filter((item) => !item.data.draft).map((item) => ({ params: { slug: item.id }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
const copy = writeupEnglish[item.id as keyof typeof writeupEnglish];
---
<ContentLayout lang="en" title={copy?.title || item.data.title} description={copy?.summary || item.data.summary} date={item.data.date} tags={[translateMetadata(item.data.platform), translateMetadata(item.data.difficulty), translateMetadata(item.data.os), ...item.data.tags]}>
  <aside class="translation-note"><strong>Translation note:</strong> the navigation and metadata are available in English; the technical report below is preserved in its original Portuguese version.</aside>
  <div lang="pt-BR"><Content /></div>
</ContentLayout>
