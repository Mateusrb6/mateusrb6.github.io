---
import { getCollection, render } from "astro:content";
import ContentLayout from "../../../layouts/ContentLayout.astro";
export async function getStaticPaths() {
  const items = await getCollection("articles");
  return items.filter((item) => !item.data.draft).map((item) => ({ params: { slug: item.id }, props: { item } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
---
<ContentLayout lang="en" title={item.data.title} description={item.data.summary} date={item.data.date} tags={item.data.tags}>
  <aside class="translation-note"><strong>Translation note:</strong> this article is preserved in its original Portuguese version.</aside>
  <div lang="pt-BR"><Content /></div>
</ContentLayout>
